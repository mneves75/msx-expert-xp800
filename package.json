{
  "name": "msx-expert-xp800",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "Interactive 3D replica of the Gradiente Expert XP-800 (Brazilian MSX, 1985) with a real MSX emulator on a period CRT",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mneves75/msx-expert-xp800.git"
  },
  "homepage": "https://msx-expert-xp800.mvneves.workers.dev",
  "bugs": "https://github.com/mneves75/msx-expert-xp800/issues",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "ast-grep scan",
    "shoot": "node tools/shoot.mjs",
    "verify": "pnpm lint && pnpm typecheck",
    "verify:all": "node tools/verify-all.mjs",
    "verify:online": "node tools/verify-all.mjs --online",
    "setup:hooks": "git config core.hooksPath .githooks",
    "deploy": "pnpm build && node node_modules/wrangler/bin/wrangler.js deploy",
    "deploy:staging": "pnpm build && node node_modules/wrangler/bin/wrangler.js deploy --env staging"
  },
  "dependencies": {
    "n8ao": "2.0.0",
    "postprocessing": "6.39.4",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@ast-grep/cli": "0.45.0",
    "@types/three": "0.185.0",
    "playwright": "1.61.1",
    "typescript": "5.9.3",
    "vite": "8.1.5",
    "wrangler": "4.119.0"
  },
  "packageManager": "pnpm@11.13.0"
}
