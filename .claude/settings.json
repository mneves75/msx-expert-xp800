{
  "permissions": {
    "deny": [
      "Edit(**/wmsx*.js)",
      "Edit(./pnpm-lock.yaml)",
      "Bash(npm install*)",
      "Bash(yarn*)",
      "Bash(bun install*)"
    ],
    "ask": [
      "Bash(pnpm deploy*)",
      "Bash(pnpm run deploy*)",
      "Bash(*scripts/release.sh*)",
      "Bash(*wrangler*deploy*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -x \"$HOME/.claude/hooks/claude-gate\" ] || \"$HOME/.claude/hooks/claude-gate\" baseline"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -x \"$HOME/.claude/hooks/claude-gate\" ] || \"$HOME/.claude/hooks/claude-gate\" stop -- 'pnpm verify:all'",
            "timeout": 900
          }
        ]
      }
    ]
  }
}
